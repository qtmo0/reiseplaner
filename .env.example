# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Zugangscode, mit dem das erste Konto angelegt wird. Lang und zufällig wählen, z. B.:  openssl rand -hex 24
APP_TOKEN=

# API-Key von https://platform.claude.com  (leer = Vorschläge ohne KI aus Wikipedia)
ANTHROPIC_API_KEY=

# Optional
APP_PORT=8090
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Kontaktadresse für die Abfragen bei OpenStreetMap und Wikipedia (deren Regeln wünschen eine)
APP_CONTACT=
# Welche Image-Version laufen soll: latest oder fest, z. B. 1.0.0
IMAGE_TAG=latest
